From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zangruochen <zangruochen@loongson.cn>
Date: Tue, 30 May 2023 15:16:27 +0800
Subject: [PATCH] BACKPORT: FROMEXT: Support LoongArch64

Link: https://github.com/fastfloat/fast_float/commit/fcee052311840e1ca5fd70573431b9e1cfae57f2
Signed-off-by: Kaiyang Wu <wukaiyang@loongfans.cn>
---
 src/arrow/cpp/src/arrow/vendored/fast_float/float_common.h | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/arrow/cpp/src/arrow/vendored/fast_float/float_common.h b/src/arrow/cpp/src/arrow/vendored/fast_float/float_common.h
index 7173201267..e51c354439 100644
--- a/src/arrow/cpp/src/arrow/vendored/fast_float/float_common.h
+++ b/src/arrow/cpp/src/arrow/vendored/fast_float/float_common.h
@@ -30,7 +30,8 @@
        || defined(__amd64) || defined(__aarch64__) || defined(_M_ARM64) \
        || defined(__MINGW64__)                                          \
        || defined(__s390x__)                                            \
-       || (defined(__ppc64__) || defined(__PPC64__) || defined(__ppc64le__) || defined(__PPC64LE__)) )
+       || (defined(__ppc64__) || defined(__PPC64__) || defined(__ppc64le__) || defined(__PPC64LE__)) \
+       || defined(__loongarch64) )
 #define FASTFLOAT_64BIT 1
 #elif (defined(__i386) || defined(__i386__) || defined(_M_IX86)   \
      || defined(__arm__) || defined(_M_ARM) || defined(__ppc__)   \
